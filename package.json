{
  "name": "nepthic-events",
  "version": "1.0.0",
  "private": true,
  "description": "Nepthic Events: events and ticketing site, its admin panel and the door scanner. Standalone: own database, accounts and payments.",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.2.6",
    "@fontsource/instrument-sans": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/unbounded": "5.2.8",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.44.7",
    "jose": "5.10.0",
    "jsqr": "1.4.0",
    "next": "15.5.27",
    "passkit-generator": "3.4.0",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "resend": "6.1.2",
    "sharp": "0.34.5",
    "stripe": "17.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "drizzle-kit": "0.31.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
