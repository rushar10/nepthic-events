# Nepthic Events — this project's own settings. Nothing here is shared with Wholesale,
# Clothing or the Gateway.

# Its own Postgres database (not the Wholesale or Clothing one).
DATABASE_URL="postgresql://postgres@localhost:5432/nepthic_events"

# Where this site is served, for emails and Stripe redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3002"
# Optional: where the Nepthic logo points. Default "/" (this site's home). Set to the
# gateway (e.g. https://nepthic.com) only if you want the logo to leave the site.
NEXT_PUBLIC_LOGO_HREF="/"

# Payments: "mock" (no Stripe needed, payments succeed instantly) or "stripe".
PAYMENTS_MODE="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Long random string that signs every e-ticket QR code. Never change it after launch.
TICKET_SIGNING_SECRET="replace-with-64-random-characters"

# Email (Resend). Without a key, emails go to the console and the email_log table.
RESEND_API_KEY=""
EMAIL_FROM="Nepthic Events <events@nepthic.com>"
ADMIN_NOTIFY_EMAIL="events-team@nepthic.com"

# First admin account (npm run db:seed)
SEED_ADMIN_EMAIL="admin@events.nepthic.com"
SEED_ADMIN_PASSWORD="change-me-now"

# Read-only summary for the optional Nepthic Overview dashboard. Leave empty to turn the
# endpoint off. Generate with: openssl rand -base64 32
OVERVIEW_API_TOKEN=""

# Optional wallet passes
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_WWDR_CERT=""
APPLE_SIGNER_CERT=""
APPLE_SIGNER_KEY=""
APPLE_SIGNER_KEY_PASSPHRASE=""
